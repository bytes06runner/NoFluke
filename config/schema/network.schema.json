{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EVM network config",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "chainId", "rpcUrl", "explorerUrl", "pyth", "usdc", "ens", "erc8004", "deployment"],
  "definitions": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "url": { "type": "string", "pattern": "^https?://" }
  },
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "rpcUrl": { "$ref": "#/definitions/url" },
    "archiveRpcUrl": { "$ref": "#/definitions/url" },
    "explorerUrl": { "$ref": "#/definitions/url" },
    "pyth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "hermesUrl", "historyUrl"],
      "properties": {
        "contract": { "$ref": "#/definitions/address" },
        "hermesUrl": { "$ref": "#/definitions/url" },
        "historyUrl": { "$ref": "#/definitions/url" }
      }
    },
    "usdc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "decimals"],
      "properties": {
        "address": { "$ref": "#/definitions/address" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 36 }
      }
    },
    "ens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentLabel", "tld", "ethRegistrar", "ethRegistry", "rootRegistry", "labelStore", "verifiableFactory", "userRegistryImpl", "permissionedResolverImpl", "universalResolver", "paymentToken"],
      "properties": {
        "parentLabel": { "type": "string", "pattern": "^[a-z0-9-]{3,}$" },
        "tld": { "type": "string", "minLength": 1 },
        "ethRegistrar": { "$ref": "#/definitions/address" },
        "ethRegistry": { "$ref": "#/definitions/address" },
        "rootRegistry": { "$ref": "#/definitions/address" },
        "labelStore": { "$ref": "#/definitions/address" },
        "verifiableFactory": { "$ref": "#/definitions/address" },
        "userRegistryImpl": { "$ref": "#/definitions/address" },
        "permissionedResolverImpl": { "$ref": "#/definitions/address" },
        "universalResolver": { "$ref": "#/definitions/address" },
        "paymentToken": { "$ref": "#/definitions/address" }
      }
    },
    "erc8004": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityRegistry", "reputationRegistry"],
      "properties": {
        "identityRegistry": { "$ref": "#/definitions/address" },
        "reputationRegistry": { "$ref": "#/definitions/address" }
      }
    },
    "deployment": {
      "type": "object",
      "description": "Filled by the deploy script, one address per contract we deploy.",
      "additionalProperties": { "$ref": "#/definitions/address" }
    }
  }
}
