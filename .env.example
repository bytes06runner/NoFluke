# Copy to .env (never committed). Deployer and settler keys live in cast keystores, not here.
# Pyth API key (Pyth Terminal): every Hermes call needs it.
PYTH_API_KEY=
# Public addresses of the keystore wallets
DEPLOYER_ADDRESS=
SETTLER_ADDRESS=
# Arkiv access key (hub.arkiv.network/access-keys), if the public RPC rate limits us
ARKIV_ACCESS_KEY=
# World Agent Pass OIDC client (auth.world.org/portal)
WORLD_OIDC_CLIENT_ID=
WORLD_OIDC_CLIENT_SECRET=
# World ID app for IDKit (developer.worldcoin.org)
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# Swarm upload endpoint and postage batch
SWARM_BEE_URL=
SWARM_BATCH_ID=
