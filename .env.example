# Copy to .env (never committed). Deployer and settler keys live in cast keystores, not here.
# Pyth API key (Pyth Terminal): every Hermes call needs it.
PYTH_API_KEY=
# Public addresses of the keystore wallets
DEPLOYER_ADDRESS=
SETTLER_ADDRESS=
# Arkiv access key (hub.arkiv.network/access-keys), if the public RPC rate limits us
ARKIV_ACCESS_KEY=
